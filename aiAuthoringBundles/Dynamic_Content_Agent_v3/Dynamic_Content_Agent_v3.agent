config:
    developer_name: "Dynamic_Content_Agent_v3"
    agent_label: "Dynamic Content Agent"
    description: |
        Builds CMS emails from content elements and can wire in dynamic-content
        personalization. Hand-authored Agent Script port of the legacy-builder
        AuraPoc_Email_Builder bot -- reuses the same Apex actions and prompt
        template, but replaces the old natural-language-only confirmation
        instruction with real deterministic gates: the build action is not
        available to the LLM until the user has explicitly approved the
        drafted plan, branding has actually been resolved, and the plan has
        actually passed structural validation. The drafting pipeline itself
        (structure -> copy -> assembly -> validation) also runs
        deterministically via after_reasoning, rather than depending on the
        LLM to remember to call each step.

        Authored by Toby Trammell.
    agent_type: "AgentforceEmployeeAgent"

system:
    instructions: |
        You help the user build marketing emails in Salesforce CMS, optionally
        personalized with Data Cloud dynamic content. You never build or
        personalize an email without first showing the user a plain-language
        summary of exactly what you are about to build and getting their
        explicit approval.
    messages:
        welcome: "Hi! I can help you build a CMS email, personalized or not. What would you like to create?"
        error: "Sorry, I ran into a problem handling that. Let's try again -- what would you like to do?"

language:
    default_locale: "en_US"
    additional_locales: "ja,fr,es"

variables:
    base_brand_context: mutable string = "None available"
        description: "Brand asset name-to-contentKey pairs discovered via Find Brand Assets. \"None available\" until looked up -- never empty/null, since the underlying prompt template's merge resolution fails hard on a null input."

    base_data_graphContext: mutable string = "None available"
        description: "Confirmed data-graph field API names available for personalization. \"None available\" until looked up -- never empty/null, since the underlying prompt template's merge resolution fails hard on a null input."

    base_brand_voice: mutable string = "None available"
        description: "Brand record description/identity/tone from Find Brand Record -- distinct from brandContext, which is only asset pointers. Feeds Write Email Copy's tone. \"None available\" until looked up or no brand record found."

    base_brand_allRecordsJson: mutable string = ""
        description: "Every CMS brand record's name+contentKey (no voice -- fetched separately per selected brand), cached once at session start. Use to confirm a brand exists and get its contentKey without a live call."

    base_data_fieldsJson: mutable string = ""
        description: "This org's Data Cloud data graph fields, fetched once at session start. Empty if auto-resolve failed -- check dataGraphCount, not this field, to see why."

    base_data_graphCount: mutable number = -1
        description: "Deterministic, not LLM-set. -1 = not yet checked. 0 = zero data graphs exist, build plain. 1 = resolved cleanly. >1 = ambiguous, ask user (see availableGraphNamesJson)."

    base_data_availableGraphNames: mutable string = ""
        description: "Only meaningful when dataGraphCount > 1 -- the real graph names to ask the user to choose from."

    base_data_resolvedGraphApiName: mutable string = ""
        description: "The actual data graph name resolved (auto-detected or user-confirmed). Needed to build deterministically -- Build Dynamic Email can't call itself with an LLM-filled value."

    base_data_ambiguityMessage: mutable string = ""
        description: "Human-readable version of the same resolution failure dataGraphCount describes. Prefer dataGraphCount for branching -- this is for display only."

    base_data_hydrated: mutable boolean = False
        description: "Deterministic flag, not LLM-set -- True once the one-time session-start fetch of allBrandRecordsJson/allDataGraphFieldsJson has run. Never fetch these again after this is True."

    base_content_userIntent: mutable string = ""
        description: "User's verbatim email request, captured by note_email_request -- NOT an LLM echo. after_reasoning binds it to Plan Email Structure and Fill Copy so full-translate/multi-lingual fires cold. A new request overwrites it and clears the plan."

    base_content_structurePlanJson: mutable string = ""
        description: "The most recently planned email structure (content slots + personalization needs, no final copy), as JSON, from Plan Email Structure. Set deterministically in after_reasoning (bound to base_content_userIntent), not by an LLM tool call."

    base_content_copyJson: mutable string = ""
        description: "The final creative copy for the current structure plan, as JSON, from Write Email Copy."

    base_content_title: mutable string = ""
        description: "Title from the most recently assembled content plan -- pass through to Build Dynamic Email unchanged, never retype it."

    base_content_subjectLine: mutable string = ""
        description: "Subject line from the most recently assembled content plan -- pass through to Build Dynamic Email unchanged, never retype it."

    base_content_preheader: mutable string = ""
        description: "Preheader from the most recently assembled content plan -- pass through to Build Dynamic Email unchanged, never retype it."

    base_content_elementsJson: mutable string = ""
        description: "elementsJson from the most recently assembled content plan -- pass through to Build Dynamic Email unchanged. Never retype this JSON from memory -- that silently dropped a target slot in a real run."

    base_content_urlName: mutable string = ""
        description: "Deterministically generated urlName from the most recently assembled plan. Never LLM-filled -- needed so Build Dynamic Email can be called without an LLM turn present."

    base_content_personalizationsJson: mutable string = ""
        description: "personalizationsJson from the most recently assembled content plan -- pass through to Build Dynamic Email unchanged. Never retype this JSON from memory -- that silently dropped a target slot in a real run."

    base_content_planSummary: mutable string = ""
        description: "Deterministic (Assemble Content Plan) human summary of the personalization -- counts of PersonalizationPoints (PPs), variants/decisions (OPs), target slots, and the data graph. Shown verbatim on the confirm dialog's Personalization field."

    base_content_planApproved: mutable boolean = False
        description: "v21 explicit-confirm gate. Set True by confirm_plan_tool when the user approves the plan summary; build_dynamic_email_tool is not available until it is True. Cleared by note_email_request (a fresh/revised plan needs re-approval)."

    base_brand_logoKey: mutable string = ""
        description: "Logo contentKey resolved at checklist step 2 -- stored once so Build Dynamic Email reads it durably instead of re-deriving it from conversation history, which silently drops branding in a long back-and-forth."

    base_brand_headerKey: mutable string = ""
        description: "Header image contentKey resolved at checklist step 2 -- same durable-storage reasoning as resolvedLogoKey."

    base_brand_recordKey: mutable string = ""
        description: "Brand RECORD contentKey (colors/fonts/buttons) resolved at checklist step 2, only if the user asked for a specific brand. Empty when no brand record applies -- same durable-storage reasoning as resolvedLogoKey."

    base_brand_workspaceId: mutable string = ""
        description: "CMS workspace id for the chosen brand (or org default), resolved at checklist step 2. Needed to build deterministically -- never leave this for the LLM to fill in at build time."

    base_brand_include: mutable boolean = True
        description: "Whether the banner/footer wraps the email at all -- resolved once at checklist step 2, stored durably instead of re-derived at build time."

    base_brand_suppressLogo: mutable boolean = False
        description: "True only when checklist step 2 found no brand logo AND no org default logo either -- stored durably instead of re-derived at build time."

    base_brand_suppressHeader: mutable boolean = False
        description: "True only when checklist step 2 found no brand header AND no org default header either -- stored durably instead of re-derived at build time."

    base_brand_resolved: mutable boolean = False
        description: "Deterministic gate, not LLM-set -- True only after the branding commit (resolve_branding_action, after_reasoning) binds the resolved* keys. Build stays unavailable until True; the LLM cannot set this or the resolved keys (LLM path removed)."

    base_content_validated: mutable boolean = False
        description: |
            Deterministic gate, not LLM-set -- True only once
            validate_content_plan_tool has passed for the CURRENT plan.
            Reset to False whenever assemble_content_plan_tool reruns. Build
            Dynamic Email stays unavailable until this is True.

    base_error_stalled: mutable boolean = False
        description: |
            Deterministic, not LLM-set. True only when the automatic
            drafting pipeline hit a real failure and stopped retrying --
            check pipelineErrorMessage/pipelineIssuesJson, tell the user.
            Reset to False by a fresh note_email_request call.

    base_error_pipeline: mutable string = ""
        description: "Set by the automatic drafting pipeline if assemble_content_plan_tool failed. Empty means no failure yet."

    base_error_issuesJson: mutable string = ""
        description: "Set by the automatic drafting pipeline after validate_content_plan_tool runs. Non-empty/non-[] means real structural issues were found."

    base_build_attempted: mutable boolean = False
        description: "Deterministic, not LLM-set. True once the automatic pipeline has called Build Dynamic Email for the CURRENT plan -- prevents re-building every turn. Reset by a fresh note_email_request call."

    base_build_success: mutable boolean = False
        description: "The REAL success value from Build Dynamic Email's last automatic call. Only source of truth for whether anything was built -- never restate the plan instead of this."

    base_build_personalized: mutable boolean = False
        description: "The REAL personalized value from Build Dynamic Email's last automatic call. False means the built email has NO dynamic content, even if personalization was requested."

    base_build_contentKey: mutable string = ""
        description: "The REAL contentKey of the built email, if buildSuccess is True. Empty if nothing was built."

    base_error_build: mutable string = ""
        description: "The REAL error message from Build Dynamic Email's last automatic call, if buildSuccess is False."

    base_content_personalizationNote: mutable string = ""
        description: "Deterministic (Assemble Content Plan). Explains any personalization dropped or degraded (no data graph, or field not in the resolved graph). Shown verbatim in the summary so a downgrade is never silent. Empty when nothing dropped."

    base_data_needsGraphChoice: mutable boolean = False
        description: "Deterministic (Assemble Content Plan). True when personalization was requested but the org has multiple data graphs and none is resolved yet -- ask the user which graph before assembling. Distinct from the count==0 plain-email fallback."

    base_data_graphChoiceMessage: mutable string = ""
        description: "Deterministic, set alongside needsGraphChoice -- the exact ask-the-user message listing the available graphs. Empty unless needsGraphChoice is True."

    base_brand_note: mutable string = ""
        description: "Deterministic, set by Resolve Branding. Human-readable summary of the committed branding (logo/header set or suppressed, brand record applied or not). Shown in the pre-approval summary."

    base_brand_requestedName: mutable string = ""
        description: "INTENT ONLY -- the brand the user named for this email (e.g. 'Epicor'), set by the LLM via note_requested_brand. The deterministic brand lookup in after_reasoning reads this to fetch the brand's assets/record/voice. Empty = no brand named (org default)."

    base_brand_lookedUpName: mutable string = ""
        description: "Deterministic, not LLM-set. The brand name the deterministic lookup last fetched assets for. When it differs from base_brand_requestedName, the lookup re-runs -- so a brand change re-fetches, and an unchanged brand isn't re-fetched every turn."

start_agent agent_router:
    description: "Welcome the user and start the dynamic email builder."
    reasoning:
        instructions: ->
            transition to @subagent.plan

subagent email_context:
    description: |
        Looks up brand assets and confirmed data-graph fields on request.
        Never creates, changes, or personalizes anything.

    actions:
        find_brand_assets_action:
            description: "Search CMS image content by name/URL slug (e.g. \"logo\", \"header\") and return each match's contentKey and managedContentId, for use as an image element's contentKey. Use this instead of guessing or asking the user for a raw content key."
            inputs:
                searchTerm: string
                    description: "Text to match against CMS image content names, e.g. \"logo\", \"header\", \"default-email-template\" (hyphens, matching the real naming convention -- spaces won't match)."
                    is_required: True
                maxResults: integer
                    description: "Maximum number of matches to return; leave blank to use the org default (25) rather than passing a smaller number yourself."
            outputs:
                success: boolean
                assetsJson: string
                    description: "JSON array of {name, urlName, contentKey, managedContentId, workspaceId} for each matching image. workspaceId is the CMS workspace this asset lives in -- usable directly as contentSpaceOrFolderId to build the email in that same workspace, without a separate workspace lookup."
                errorMessage: string
            target: "apex://FindBrandAssetsAction"

        find_brand_record_action:
            description: "Search CMS brand records (colorScheme/typography/button styling) by name and return each match's contentKey. Distinct from Find Brand Assets, which only finds logo/header pictures -- without this, an email still renders with generic default colors/fonts even if the right logo/header images are used. Omit searchTerm to list every brand record in the org."
            inputs:
                searchTerm: string
                    description: "Text to match against CMS brand record names, e.g. \"AMD\". Omit to list every brand record in the org -- useful to check whether a specific brand actually has a brand record at all, distinct from just having logo/header images."
                    is_required: False
                maxResults: integer
                    description: "Maximum number of matches to return; leave blank to use the org default (25) rather than passing a smaller number yourself."
            outputs:
                success: boolean
                brandsJson: string
                    description: "JSON array of {name, contentKey, workspaceId, description, identity, tone}. workspaceId is the CMS workspace this record lives in. description/identity/tone are the brand's voice -- empty when undefined."
                errorMessage: string
            target: "apex://FindBrandRecordAction"

        data_graph_details_action:
            description: "Fetch a Data Cloud data graph definition (DMOs and fields) so you know what personalization criteria are actually available before wiring dynamic content. Auto-detects the org's data graph if none is specified."
            inputs:
                graphApiName: string
                    description: "API name of a specific Data Cloud data graph to look up. Leave blank in almost all cases -- the action auto-detects the org's data graph. Only pass a name if the user has told you this org has multiple graphs and specified which one."
                    is_required: False
            outputs:
                success: boolean
                fieldsJson: string
                    description: "The full data graph definition (DMOs and fields) as JSON."
                resolvedGraphApiName: string
                    description: "The actual data graph API name that was queried, whether auto-detected or explicitly passed."
                graphCount: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Only set when fieldsJson is empty. 0 = no data graphs exist in this org. >1 = ambiguous, see availableGraphNamesJson."
                availableGraphNamesJson: string
                    description: "Only set when fieldsJson is empty. The real graph names to choose from when graphCount > 1."
                errorMessage: string
                    description: "If this org has more than one data graph and none/an invalid name was specified, lists the real available names here -- ask the user which one to use rather than guessing."
            target: "apex://DataGraphDetailsAction"

    reasoning:
        instructions: ->
            | Use whichever action matches what's being looked up: brand
              assets (logo/header images), the brand's own record (colors/
              fonts/buttons), data-graph fields, or any combination. When the
              user names a specific brand, look up BOTH its assets and its
              brand record -- images alone only swap pictures, not the
              email's actual color/font/button styling. Both results include
              a workspaceId -- report that too, since it can be used
              directly as the CMS workspace to build the email in, without a
              separate workspace lookup. Store brand asset results in
              {!@variables.base_brand_context} and data-graph results in
              {!@variables.base_data_graphContext} as plain, human-readable text
              (not raw JSON) so a later prompt can read them directly. Never
              fabricate a contentKey, workspace id, or field name -- only
              report what an action actually returned.

        actions:
            find_brand_assets_tool: @actions.find_brand_assets_action
                with searchTerm = ...
                with maxResults = ...
                set @variables.base_brand_context = @outputs.assetsJson
                # A fresh lookup changes the brand -- force the deterministic branding
                # commit (after_reasoning, gated on brandingResolved == False) to re-run
                # against the new context instead of keeping a prior brand's committed keys.
                set @variables.base_brand_resolved = False

            find_brand_record_tool: @actions.find_brand_record_action
                with searchTerm = ...
                with maxResults = ...
                set @variables.base_brand_voice = @outputs.brandsJson
                set @variables.base_brand_resolved = False

            get_data_graph_details_tool: @actions.data_graph_details_action
                with graphApiName = ...
                set @variables.base_data_graphContext = @outputs.fieldsJson
                set @variables.base_data_fieldsJson = @outputs.fieldsJson
                set @variables.base_data_graphCount = @outputs.graphCount
                set @variables.base_data_availableGraphNames = @outputs.availableGraphNamesJson
                set @variables.base_data_resolvedGraphApiName = @outputs.resolvedGraphApiName

subagent plan:
    description: |
        Discovers context (brands, assets, data graph) and drafts a validated,
        branded content plan for an email -- structure, per-cell copy, assembly,
        validation, and the deterministic branding commit. Builds nothing. Once
        the plan is assembled, validated, and branded, it hands off to the build
        subagent for the final confirm-to-build step.

    actions:
        hydrate_brand_records_action:
            description: "Deterministic session-start fetch of every brand's name/contentKey (no voice -- too expensive org-wide). Called once from before_reasoning, never exposed as an LLM choice."
            inputs:
                searchTerm: string
                maxResults: integer
                includeVoice: boolean
            outputs:
                success: boolean
                brandsJson: string
                errorMessage: string
            target: "apex://FindBrandRecordAction"

        hydrate_data_graph_action:
            description: "Deterministic, session-start-only fetch of this org's Data Cloud data graph fields. Never exposed to the LLM as a choice -- called once from before_reasoning, not on demand."
            inputs:
                graphApiName: string
            outputs:
                success: boolean
                fieldsJson: string
                resolvedGraphApiName: string
                graphCount: object
                    complex_data_type_name: "lightning__integerType"
                availableGraphNamesJson: string
                errorMessage: string
            target: "apex://DataGraphDetailsAction"

        find_brand_assets_action:
            description: "Search CMS image content by name/URL slug and return each match's contentKey + workspaceId. Used by the deterministic brand lookup in after_reasoning -- not an LLM choice."
            inputs:
                searchTerm: string
                    description: "Brand name (or 'default-email-template') to match against CMS image content names."
                    is_required: True
                maxResults: integer
                    description: "Max matches; leave blank for the org default (25)."
            outputs:
                success: boolean
                assetsJson: string
                    description: "JSON array of {name, urlName, contentKey, managedContentId, workspaceId} for each matching image."
                errorMessage: string
            target: "apex://FindBrandAssetsAction"

        find_brand_record_action:
            description: "Search CMS brand records (colorScheme/typography + description/identity/tone voice) by name. Used by the deterministic brand lookup in after_reasoning -- not an LLM choice."
            inputs:
                searchTerm: string
                    description: "Brand name to match against CMS brand record names."
                    is_required: False
                maxResults: integer
                    description: "Max matches; leave blank for the org default (25)."
            outputs:
                success: boolean
                brandsJson: string
                    description: "JSON array of {name, contentKey, workspaceId, description, identity, tone}."
                errorMessage: string
            target: "apex://FindBrandRecordAction"

        build_dynamic_email_action_v2:
            label: "Dynamic Content Email"
            description: "Creates a CMS email from content elements, and optionally wires in dynamic content personalization, in one atomic call. If personalization fails, the created email is deleted rather than left half-built."
            require_user_confirmation: True
            inputs:
                contentSpaceOrFolderId: string
                    label: "CMS Workspace"
                    description: "Id of the CMS workspace to create the email in. Bound to the deterministically resolved workspace -- not LLM-filled."
                    is_required: True
                title: string
                    label: "Email Name"
                    description: "Human-readable name/title of the email content item."
                    is_required: True
                brandingSummary: string
                    label: "Branding"
                    description: "Display-only, shown on the confirm dialog for review: names the brand and its resolved logo/header/record. Not used by the build."
                urlName: string
                    label: "URL Slug"
                    description: "Unique URL slug for the email content item (distinct from the human name)."
                    is_required: True
                subjectLine: string
                    label: "Subject Line"
                    description: "Email subject line."
                    is_required: True
                preheader: string
                    label: "Preheader"
                    description: "Email preheader/preview text. Required by the CMS email content type."
                    is_required: True
                elementsJson: string
                    description: "JSON array of assembled content elements. Bound to the assembled plan -- not LLM-filled."
                    is_required: True
                includeBranding: boolean
                    description: "When true (default), wraps the elements with a logo/header banner and address/unsubscribe footer."
                logoContentKeyOverride: string
                    label: "Logo"
                    description: "contentKey of the logo. Bound to the deterministically resolved logo key -- not LLM-filled."
                headerContentKeyOverride: string
                    label: "Header"
                    description: "contentKey of the header image. Bound to the deterministically resolved header key -- not LLM-filled."
                suppressLogo: boolean
                    description: "Omit the logo from the banner. Bound to the deterministic suppress flag -- not LLM-filled."
                suppressHeader: boolean
                    description: "Omit the header from the banner. Bound to the deterministic suppress flag -- not LLM-filled."
                brandContentKeyOverride: string
                    label: "Brand Record"
                    description: "contentKey of the brand record (colors/fonts). Bound to the deterministically resolved brand-record key -- not LLM-filled."
                personalizationsJson: string
                    description: "JSON array of PersonalizationPoint specs. Bound to the assembled plan -- not LLM-filled."
                dataSpaceName: string
                    description: "Data Cloud data space (almost always 'default'). Bound to 'default'."
                profileDataGraphName: string
                    label: "Data Graph"
                    description: "The data graph the decisions evaluate against. Bound to the resolved graph name -- not LLM-filled."
                personalizationSummary: string
                    label: "Personalization"
                    description: "Display-only, shown on the confirm dialog for review: a short human summary of the personalization (axes/fields, variant counts, target slots, data graph). Not used by the build."
                validationSummary: string
                    label: "Validation"
                    description: "Display-only, shown on the confirm dialog for review: a short human summary of the validation result. Not used by the build."
            outputs:
                success: boolean
                    description: "Whether the whole call succeeded. If personalization was requested and failed, this is false even though the email was briefly created -- it's automatically rolled back (see rolledBack)."
                contentKey: string
                managedContentId: object
                    complex_data_type_name: "lightning__textType"
                blockIdsJson: string
                personalized: boolean
                ppName: string
                variantIdsJson: string
                rolledBack: boolean
                    description: "True if personalization failed and the created email was successfully deleted. If false while success is also false, the email may still exist and needs manual cleanup."
                errorMessage: string
            target: "apex://BuildDynamicEmailAction"

        plan_email_structure_action:
            description: "Decides email structure (content slots and personalization needs) from a plain-language request, without writing any final copy. Creates nothing, makes no changes."
            inputs:
                "Input:UserIntent": string
                    description: "Plain-language description of what the email should contain and, if applicable, how it should be personalized. Use the user's own request -- don't paraphrase away specifics they gave you."
                    is_required: True
                "Input:BrandContext": string
                    description: "Brand asset name-to-contentKey pairs already discovered. Omit if none found -- never fabricate this."
                "Input:DataGraphContext": string
                    description: "Confirmed data-graph field API names available for personalization. Omit if none confirmed -- never fabricate this."
            outputs:
                promptResponse: string
                    description: "JSON: titleGoal/subjectLineGoal/preheaderGoal, slots[] (key/type/goal -- image slots also carry contentKey/altText/widthPercent, button slots also carry linkGoal), personalizations[] (name/label/fieldApiName/scope/matchType/value/values/appliesToSlots). Contains no final copy -- goals/descriptions only."
                generationId: string
            target: "prompt://AuraPoc_PlanEmailStructureV2"

        fill_copy_action:
            description: "Deterministically fills every email copy cell (each slot's default plus one variant per personalization decision) with a narrow per-cell LLM call, guaranteeing complete coverage. Returns the copyJson Assemble Content Plan expects. Replaces the monolithic Write Email Copy step -- coverage is guaranteed by the loop, not the model. Creates nothing."
            inputs:
                structurePlanJson: string
                    description: "The structurePlanJson just produced by Plan Email Structure."
                    is_required: True
                brandVoice: string
                    description: "The brand record's description/identity/tone (from Find Brand Record), if a brand record was found. Omit for a neutral, professional tone."
            outputs:
                success: boolean
                copyJson: string
                    description: "JSON: title/subjectLine/preheader plus copyBySlot keyed by each slot's key -- each {default, url (buttons only), byPersonalization keyed by personalization name}."
                normalizedPlanJson: string
                    description: "The structure plan this fill ran against, after any deterministic full-translate normalization (Country PP injected across every text slot). Bind base_content_structurePlanJson to this so Assemble Content Plan sees the SAME plan the copy was filled for. Always non-empty -- equals the input plan when nothing was injected."
                errorMessage: string
                    description: "Set only when copy could NOT be generated (e.g. the plan needs more copy cells than the per-email limit). Empty on success."
            target: "apex://FillCopyAction"

        assemble_content_plan_action_v2:
            description: "Deterministically merges a structure plan and its written copy into the elementsJson/personalizationsJson shape Build Dynamic Email expects -- one PersonalizationPoint per independent personalization axis. Also enforces the data-graph gate: drops personalization when no graph is configured (plain email), flags when a graph must be chosen, and drops any field not in the resolved graph. Makes no callouts and creates nothing."
            inputs:
                structurePlanJson: string
                    description: "The structurePlanJson from Plan Email Structure."
                    is_required: True
                copyJson: string
                    description: "The copyJson from Write Email Copy, for that SAME structure plan."
                    is_required: True
                resolvedGraphApiName: string
                    description: "The data graph resolved this session (blank if none/ambiguous)."
                availableFieldsJson: string
                    description: "Flattened field catalog for the resolved graph, for field-existence checks."
                dataGraphCount: integer
                    description: "0 = none configured (degrade to plain), 1 = resolved, >1 = ambiguous."
                availableGraphNamesJson: string
                    description: "Graph names to offer the user when a choice is needed."
            outputs:
                success: boolean
                title: string
                subjectLine: string
                preheader: string
                urlName: string
                    description: "Deterministically slugified from title plus a unique suffix -- never LLM-filled, so Build Dynamic Email can be called without an LLM turn present."
                elementsJson: string
                    description: "JSON array of content elements, ready for Build Dynamic Email."
                personalizationsJson: string
                    description: "JSON array of {ppName, ppLabel, decisionsJson, targetsJson} -- one entry per independent personalization axis, ready for Build Dynamic Email. Omitted when the structure plan had no personalizations (or all were dropped by the data-graph gate)."
                personalizationNote: string
                    description: "Human-readable note about any personalization dropped or degraded -- show verbatim in the summary."
                needsGraphChoice: boolean
                    description: "True when personalization needs a data graph choice before it can proceed -- ask the user."
                planSummary: string
                    description: "Deterministic PP/variant(OP)/slot counts + data graph, for the confirm dialog's Personalization field."
                errorMessage: string
            target: "apex://AssembleContentPlanAction"

        validate_content_plan_action_v2:
            description: "Checks a drafted plan's elementsJson/personalizationsJson for structural problems -- missing textByDecision entries, unknown element keys, invalid decision criteria, too many PersonalizationPoints or decisions, AND (backstop) any personalization field not present in the resolved data graph or a personalized plan with no resolved graph -- before the user is ever asked to approve it. Creates nothing, makes no changes."
            inputs:
                elementsJson: string
                    description: "The elementsJson just produced by Assemble Content Plan."
                    is_required: True
                personalizationsJson: string
                    description: "The personalizationsJson just produced by Assemble Content Plan, if personalizing. Omit if not personalizing."
                resolvedGraphApiName: string
                    description: "The data graph resolved this session (blank if none) -- a personalized plan with no resolved graph is invalid."
                availableFieldsJson: string
                    description: "Flattened field catalog for the resolved graph, for field-existence backstop checks."
            outputs:
                isValid: boolean
                issuesJson: string
                    description: "JSON array of human-readable problems found; empty array when valid."
                errorMessage: string
            target: "apex://ValidateContentPlanAction"

        resolve_branding_action:
            description: "Deterministically commits the looked-up brand assets/record (brandContext/brandVoiceContext) into the durable resolved branding keys Build Dynamic Email reads. Makes no callouts and creates nothing."
            inputs:
                brandContext: string
                    description: "Find Brand Assets output (assets JSON), or 'None available'."
                brandVoiceContext: string
                    description: "Find Brand Record output (records JSON), or 'None available'."
            outputs:
                resolvedLogoKey: string
                resolvedHeaderKey: string
                resolvedBrandRecordKey: string
                resolvedContentSpaceId: string
                includeBranding: boolean
                suppressLogo: boolean
                suppressHeader: boolean
                brandingResolved: boolean
                brandingNote: string
                    description: "Human-readable summary of the committed branding, for the pre-approval summary."
            target: "apex://ResolveBrandingAction"

    before_reasoning:
        # Deterministic, once per session -- no LLM judgment call on whether to fetch.
        # Confirmed live: leaving the brand-existence check as an LLM-optional tool meant
        # the model sometimes skipped it entirely and fabricated a contentKey instead of
        # ever calling a real action. Caching a cheap name/contentKey catalog up front
        # removes that failure mode structurally. Deliberately NOT hydrating images or
        # brand voice here -- both are per-brand/per-callout costs (confirmed live: voice
        # alone did 28 callouts for the whole org and blew past the per-turn time budget).
        # Those stay on-demand, targeted to the ONE brand actually selected, same as before
        # hydration existed.
        if @variables.base_data_hydrated == False:
            run @actions.hydrate_brand_records_action
                with searchTerm = ""
                with maxResults = 100
                with includeVoice = False
                set @variables.base_brand_allRecordsJson = @outputs.brandsJson

            run @actions.hydrate_data_graph_action
                with graphApiName = ""
                set @variables.base_data_fieldsJson = @outputs.fieldsJson
                set @variables.base_data_graphContext = @outputs.fieldsJson
                set @variables.base_data_ambiguityMessage = @outputs.errorMessage
                set @variables.base_data_graphCount = @outputs.graphCount
                set @variables.base_data_availableGraphNames = @outputs.availableGraphNamesJson
                set @variables.base_data_resolvedGraphApiName = @outputs.resolvedGraphApiName

            set @variables.base_data_hydrated = True

    reasoning:
        instructions: ->
            # Deterministic guard, no LLM involved -- runs on every parse
            # regardless of what the model does. Confirmed live: a
            # mid-conversation revision unrelated to branding caused
            # resolvedBrandRecordKey to collide with the logo/header key,
            # which Build Dynamic Email hard-rejects. Self-heal it here
            # instead of relying on a prompt instruction not to do this.
            if @variables.base_brand_recordKey != "" and (@variables.base_brand_recordKey == @variables.base_brand_logoKey or @variables.base_brand_recordKey == @variables.base_brand_headerKey):
                set @variables.base_brand_recordKey = ""

            | You are the dynamic-content email builder. You fill the plan variables
              (structure, copy, data graph, branding), show the user a summary, get their
              EXPLICIT approval, and only then build. You never build without explicit
              approval -- build_dynamic_email_tool is not even available until approval is
              recorded (via confirm_plan_tool).

              ABSOLUTE FIRST: if {!@variables.base_data_needsGraphChoice} is True, the plan
              needs a specific data graph chosen before it can be assembled. Do NOT
              hand off. Show the user {!@variables.base_data_graphChoiceMessage} (it lists
              this org&apos;s available data graphs), ask which one to use, and WAIT.
              When they name one, call {!@actions.lookup_email_context} to look up that
              graph by name, then call {!@actions.note_email_request} again with
              the user&apos;s original request. Do nothing else while needsGraphChoice
              is True.

              If {!@variables.base_error_stalled} is True, the automatic pipeline hit
              a real failure and stopped. Do not describe any plan as built or ready.
              Respond with exactly this and nothing else: &quot;The build stopped because
              of a real error: {!@variables.base_error_pipeline}. Would you like
              to revise the plan, or try a different approach?&quot; Calling
              {!@actions.note_email_request} again for a revised request resets
              the pipeline and clears the stall.

              ALREADY BUILT: if {!@variables.base_build_attempted} is True, the email was
              already created this session -- do NOT re-plan, do NOT re-show the summary,
              and do NOT call confirm/build again. Report the outcome using exactly one
              pattern and nothing else:
              - If {!@variables.base_build_success} is True: &quot;Built successfully. Content
                Key: {!@variables.base_build_contentKey}.&quot; Then, ONLY if
                {!@variables.base_build_personalized} is False on a plan that requested
                personalization, add one plain sentence that it built WITHOUT
                personalization and why (facts already in context only; never invent).
              - If {!@variables.base_build_success} is False: &quot;Build failed:
                {!@variables.base_error_build}. Nothing was created. Would you like to
                revise the plan, or try a different approach?&quot;
              The ONLY exception: if the user is now asking for a NEW email or a change,
              call {!@actions.note_email_request} (and {!@actions.note_requested_brand}
              for a brand change) to start fresh -- that resets base_build_attempted and
              begins a new plan. Otherwise just report the outcome above and stop.

              CONFIRM &amp; BUILD: once the plan is assembled (base_content_elementsJson is
              non-empty), validated, and branded, and no change is pending, you are at
              the confirm step.
              APPROVAL TAKES PRIORITY -- CRITICAL: if the user's CURRENT message is an
              approval (yes / approved / looks good / proceed / go / build it / do it) and
              the plan is ready (base_content_elementsJson non-empty, validated, branded)
              and base_build_attempted is False, do NOT show or re-show the summary and do
              NOT ask again -- go STRAIGHT to confirm_plan_tool then build_dynamic_email_tool
              this same turn (see below). The build tool raises the native Approve/Cancel
              dialog, which is the user's final review -- so building immediately on their
              approval is correct; making them approve twice is a bug. Re-plan drafting can
              lag one turn behind the request, so the FIRST time you can see a ready plan the
              user may have ALREADY approved -- honor that approval, do not restate the plan.
              Only when the user has NOT yet approved this ready plan (and is not asking for
              a change) do you show the full plain-language summary of exactly what will be
              built -- built from the deterministic variables below, NEVER your own
              recollection -- and ask them to approve or change it. When you do show it,
              include every line, even when a section is empty or default:
              - Proposed email name: {!@variables.base_content_title}
              - URL slug: {!@variables.base_content_urlName}
              - Subject / preheader: {!@variables.base_content_subjectLine} /
                {!@variables.base_content_preheader}
              - Each content slot in {!@variables.base_content_elementsJson}: its type,
                default text, and any personalized variant text (state which decision
                triggers which variant).
              - Personalization: state {!@variables.base_content_planSummary} VERBATIM --
                it is the deterministic, AUTHORITATIVE summary of the personalization
                (PersonalizationPoint count, variants/OPs, target slots, and the data
                graph). Do NOT second-guess it or substitute your own judgement. It is
                &quot;static&quot; ONLY if planSummary literally reads &quot;No personalization
                (static email)&quot;; in every other case the email IS personalized -- never
                describe it as static or &quot;no recipient-based personalization.&quot;
                IMPORTANT: a language/Country PersonalizationPoint (e.g. &quot;Country
                Personalization&quot;) IS recipient-based dynamic content -- each recipient
                sees the copy in their own country's language. A multi-lingual/translated
                email is therefore PERSONALIZED (the translation IS the dynamic content);
                never call it static or say dynamic content &quot;is not enabled.&quot;
              - Personalization note: show {!@variables.base_content_personalizationNote}
                VERBATIM only if it is non-empty; if it is empty, OMIT this line entirely
                -- do NOT invent a note of your own.
              - Branding (verbatim -- authoritative): {!@variables.base_brand_note}
              - Brand voice: name the brand shaping the copy, or &quot;neutral, professional
                tone&quot; if {!@variables.base_brand_voice} is &quot;None available&quot;.
              - CTA link: the button URL, noting if it is the example.com stand-in.

              If the user asks for ANY change, (re-)plan it -- call
              {!@actions.note_requested_brand} for a brand change and/or
              {!@actions.note_email_request} for a content change -- then show the
              summary again. This loop repeats as many times as they like.

              When the user EXPLICITLY approves the summary (yes / approved / looks good /
              proceed / build it), do BOTH of these in the SAME turn, in order:
              (1) call {!@actions.confirm_plan_tool} with planApproved = true (records the
                  approval and makes build_dynamic_email_tool available), then
              (2) call {!@actions.build_dynamic_email_tool}, filling its open inputs by
                  copying the EXACT assembled values -- do NOT paraphrase, shorten, or add
                  merge tokens:
                    title = {!@variables.base_content_title}
                    brandingSummary = copy {!@variables.base_brand_note} VERBATIM (it names
                      the brand and its resolved logo/header/record).
                    subjectLine = {!@variables.base_content_subjectLine}
                    preheader = {!@variables.base_content_preheader}
                    personalizationSummary = copy {!@variables.base_content_planSummary}
                      VERBATIM (it already has the deterministic PP/variant counts and the
                      slot name+type per axis and the data graph -- do not recompute or reword it).
                    validationSummary = a short review line: since the plan passed
                      validation, state that it is validated -- all personalization fields
                      resolve in {!@variables.base_data_resolvedGraphApiName} and there are
                      no structural issues.
                  brandingSummary/personalizationSummary/validationSummary are display-only
                  (shown on the confirm dialog for review; they do not change what is built).
                  Every other input (includeBranding, urlName, content, branding keys, data
                  graph) is filled automatically from the assembled plan -- never type those.
              Calling the build tool raises the native Approve/Cancel dialog (its
              require_user_confirmation), which shows the email name, subject, preheader,
              branding, personalization and validation for a final check -- THAT dialog is
              the final gate;
              the email is created only when the user clicks Approve. Never narrate a text
              confirmation instead of calling the build tool.

              To draft (or re-draft) a plan, work through this checklist, in order.
              Never decide these unilaterally -- confirm with the user, but never block
              or fail on a miss; fall back to a safe default instead.

              1. Data graph (only if personalization is wanted at all):
                 {!@variables.base_data_fieldsJson} was already fetched
                 once at session start -- do NOT call
                 {!@actions.lookup_email_context} with a blank graphApiName,
                 that call already happened and would just repeat it.
                 Decide by the NUMBER in {!@variables.base_data_graphCount} --
                 deterministic, set by Apex, not something to infer from
                 message text:
                 - dataGraphCount == 1: already resolved cleanly (one graph,
                   or a name you confirmed earlier) -- proceed, don&apos;t
                   bother the user about this.
                 - dataGraphCount == 0: this org genuinely has zero data
                   graphs configured. Do NOT block, fail, retry, or get
                   stuck -- proceed to plan a PLAIN, non-personalized email
                   instead, and say so plainly in your summary (e.g. &quot;this
                   org has no data graph configured, so this will be a
                   static email without recipient-based personalization&quot;)
                   rather than presenting it as an error.
                 - dataGraphCount > 1: ambiguous --
                   {!@variables.base_data_availableGraphNames} has the real names
                   to choose from. Check FIRST whether the user&apos;s OWN
                   request (this message or an earlier one) already names
                   one of those -- if so, do NOT ask, just call
                   {!@actions.lookup_email_context} immediately with that
                   name as graphApiName. Only if they did NOT already name
                   one, ask the user in a plain chat message exactly which
                   of those names they want (list them out), and WAIT for
                   their reply -- then call {!@actions.lookup_email_context}
                   once they answer, passing their chosen name as
                   graphApiName. Either way, this is the one case where you
                   call this action yourself -- the session-start fetch
                   couldn&apos;t have known the specific name in advance.
                 If no personalization is wanted at all, skip this step
                 entirely.

              2. Brand -- INTENT ONLY: if the user names a brand (e.g.
                 &quot;use Epicor&apos;s branding&quot;), your ONLY branding job is to
                 call {!@actions.note_requested_brand} with that brand name,
                 exactly as the user said it. You do NOT look up assets, you do
                 NOT read {!@variables.base_brand_allRecordsJson}, and you NEVER
                 type or choose contentKeys. A deterministic step then fetches
                 that brand&apos;s logo, header, and brand record + voice and
                 commits them -- it runs before the copy is written, so the
                 brand voice shapes the wording. If the user names NO brand,
                 don&apos;t call it: the deterministic commit falls back to the
                 org default assets on its own. If the user later CHANGES the
                 brand, call {!@actions.note_requested_brand} again with the new
                 name (the deterministic step re-fetches and re-commits). This
                 is the whole point of the plan stage: you fill intent
                 variables, deterministic code fills the rest, and the build
                 stage shows the result for confirmation.

              3. Call to action link: TEMPORARY testing shortcut -- do NOT
                 ask the user for a URL. If they haven&apos;t given a real one,
                 use &quot;https://www.example.com&quot; as the button&apos;s url --
                 this domain is now in this org&apos;s Trusted URLs (added
                 specifically for this), so it will actually work. Do NOT use
                 a bare &quot;#&quot; anchor -- confirmed live that this org&apos;s
                 button-action URL validation rejects it outright as an
                 invalid format. Also do NOT use the literal string
                 &quot;PLACEHOLDER-URL-NEEDS-REAL-LINK&quot; -- CMS rejects that too
                 (also confirmed live). State plainly in your summary that
                 the CTA link is example.com, a stand-in, not a working
                 destination for this email&apos;s actual purpose. (This
                 replaces the earlier behavior of blocking on user
                 confirmation of a real URL -- that behavior should be
                 restored before any real send/demo
                 use.)

              Then call {!@actions.note_email_request} with the user's request copied
              VERBATIM (their exact words). That is the ONLY drafting call you make.
              Everything else -- brand lookup + commit, structure planning, per-cell
              copy, assembly, and validation -- then runs AUTOMATICALLY and
              deterministically after your turn, in that order, bound to the request you
              just captured (so translation/multi-lingual intent is honored cold, and
              the plan is built with the brand's assets and voice already resolved).
              Confirmed live that leaving any of these to LLM discretion produced a
              plausible summary with nothing actually built -- so you never call them.
              Once the pipeline finishes and the plan is assembled/validated/branded,
              show the CONFIRM &amp; BUILD summary (above) and wait -- on the user's
              explicit approval, call confirm_plan_tool then build_dynamic_email_tool
              (see above). ({!@variables.base_content_validated} is set automatically;
              assemble_content_plan_tool / validate_content_plan_tool remain only as a
              manual fallback if the automatic pipeline somehow hasn't caught up on a
              fully-assembled plan.)


        actions:
            confirm_plan_tool: @utils.setVariables
                description: "Call this ONLY when the user EXPLICITLY approves the plan summary you just showed (clearly says yes / approved / looks good / proceed / build it). Calling it always records approval -- there is no case where you call this tool and approval is NOT recorded. Only after this is build_dynamic_email_tool available. If the user wants a change instead, re-plan -- do not call this tool."
                with base_content_planApproved = true

            build_dynamic_email_tool: @actions.build_dynamic_email_action_v2
                with contentSpaceOrFolderId = @variables.base_brand_workspaceId
                with title = ...
                with brandingSummary = ...
                with urlName = @variables.base_content_urlName
                with subjectLine = ...
                with preheader = ...
                with elementsJson = @variables.base_content_elementsJson
                with includeBranding = @variables.base_brand_include
                with logoContentKeyOverride = @variables.base_brand_logoKey
                with headerContentKeyOverride = @variables.base_brand_headerKey
                with suppressLogo = @variables.base_brand_suppressLogo
                with suppressHeader = @variables.base_brand_suppressHeader
                with brandContentKeyOverride = @variables.base_brand_recordKey
                with personalizationsJson = @variables.base_content_personalizationsJson
                with dataSpaceName = "default"
                with profileDataGraphName = @variables.base_data_resolvedGraphApiName
                with personalizationSummary = ...
                with validationSummary = ...
                set @variables.base_build_success = @outputs.success
                set @variables.base_build_personalized = @outputs.personalized
                set @variables.base_build_contentKey = @outputs.contentKey
                set @variables.base_error_build = @outputs.errorMessage
                set @variables.base_build_attempted = True
                available when @variables.base_content_planApproved == True and @variables.base_content_validated == True and @variables.base_brand_resolved == True and @variables.base_data_needsGraphChoice == False and @variables.base_content_elementsJson != "" and @variables.base_build_attempted == False

            lookup_email_context: @subagent.email_context
                description: "Look up confirmed data-graph fields (for the multi-graph choice case) before drafting an email. Not for brand assets -- use note_requested_brand for that."

            note_requested_brand: @utils.setVariables
                description: "Record the brand the user named (e.g. 'Epicor'), exactly as said. Call whenever the user names or changes a brand -- a deterministic step then fetches its logo/header/record+voice; you never look those up or type contentKeys. Leave unset if no brand named."
                with base_brand_requestedName = ...

            note_email_request: @utils.setVariables
                description: "Record the user's email request VERBATIM (their exact words, not a paraphrase) whenever they ask for a NEW email or a CHANGE to the current one. This is the ONLY drafting call you make -- a deterministic pipeline then plans the structure, writes per-cell copy, assembles, validates, and commits branding automatically. Setting it starts a fresh plan (clears any prior draft and its approval)."
                with base_content_userIntent = ...
                set @variables.base_content_structurePlanJson = ""
                set @variables.base_content_copyJson = ""
                set @variables.base_content_elementsJson = ""
                set @variables.base_content_urlName = ""
                set @variables.base_content_personalizationsJson = ""
                set @variables.base_content_validated = False
                set @variables.base_error_stalled = False
                set @variables.base_error_pipeline = ""
                set @variables.base_error_issuesJson = ""
                set @variables.base_content_personalizationNote = ""
                set @variables.base_data_needsGraphChoice = False
                set @variables.base_data_graphChoiceMessage = ""
                set @variables.base_brand_resolved = False
                set @variables.base_content_planApproved = False
                set @variables.base_content_planSummary = ""
                set @variables.base_build_attempted = False
                set @variables.base_build_success = False
                set @variables.base_build_personalized = False
                set @variables.base_build_contentKey = ""
                set @variables.base_error_build = ""

            assemble_content_plan_tool: @actions.assemble_content_plan_action_v2
                with structurePlanJson = @variables.base_content_structurePlanJson
                with copyJson = @variables.base_content_copyJson
                with resolvedGraphApiName = @variables.base_data_resolvedGraphApiName
                with availableFieldsJson = @variables.base_data_fieldsJson
                with dataGraphCount = @variables.base_data_graphCount
                with availableGraphNamesJson = @variables.base_data_availableGraphNames
                set @variables.base_content_title = @outputs.title
                set @variables.base_content_subjectLine = @outputs.subjectLine
                set @variables.base_content_preheader = @outputs.preheader
                set @variables.base_content_urlName = @outputs.urlName
                set @variables.base_content_elementsJson = @outputs.elementsJson
                set @variables.base_content_personalizationsJson = @outputs.personalizationsJson
                set @variables.base_content_personalizationNote = @outputs.personalizationNote
                set @variables.base_content_planSummary = @outputs.planSummary
                set @variables.base_data_needsGraphChoice = @outputs.needsGraphChoice
                set @variables.base_error_pipeline = @outputs.errorMessage
                set @variables.base_content_validated = False
                available when @variables.base_content_structurePlanJson != "" and @variables.base_content_copyJson != ""

            validate_content_plan_tool: @actions.validate_content_plan_action_v2
                with elementsJson = @variables.base_content_elementsJson
                with personalizationsJson = @variables.base_content_personalizationsJson
                with resolvedGraphApiName = @variables.base_data_resolvedGraphApiName
                with availableFieldsJson = @variables.base_data_fieldsJson
                set @variables.base_content_validated = @outputs.isValid
                set @variables.base_error_issuesJson = @outputs.issuesJson
                available when @variables.base_content_elementsJson != "" and @variables.base_data_needsGraphChoice == False


    after_reasoning:
        # Deterministic brand resolution FIRST -- before fill_copy, so the brand voice can shape
        # the copy. The LLM's only branding input is the brand NAME (base_brand_requestedName, via
        # note_requested_brand); Apex fetches the assets + record/voice here rather than relying on
        # the model to remember to look them up. Re-fetches only when the requested brand changed
        # (tracked by base_brand_lookedUpName) and forces a re-commit (base_brand_resolved=False).
        # No brand named -> skip; the branding commit below falls back to the org default by slug.
        if @variables.base_brand_requestedName != "" and @variables.base_brand_requestedName != @variables.base_brand_lookedUpName:
            run @actions.find_brand_assets_action
                with searchTerm = @variables.base_brand_requestedName
                with maxResults = 25
                set @variables.base_brand_context = @outputs.assetsJson
            run @actions.find_brand_record_action
                with searchTerm = @variables.base_brand_requestedName
                with maxResults = 25
                set @variables.base_brand_voice = @outputs.brandsJson
            set @variables.base_brand_lookedUpName = @variables.base_brand_requestedName
            set @variables.base_brand_resolved = False

        # Deterministic branding commit -- MOVED AHEAD of Plan (was last) so the plan and the whole
        # pipeline run with branding already resolved, per the brand-before-plan ordering. Commits
        # the looked-up assets/record (or the org default when no brand was named) into the durable
        # resolved* keys Build Dynamic Email reads; makes no callout. Runs once per request (gated on
        # base_brand_resolved==False, which note_email_request/brand-lookup reset). The former
        # LLM-callable path was removed because the model silently blanked the keys while flipping
        # brandingResolved=True, dropping branding to the org default while the summary still claimed
        # the brand -- now only this action (bound to @outputs, never LLM-typed) sets them.
        if @variables.base_content_userIntent != "" and @variables.base_brand_resolved == False and @variables.base_error_stalled == False:
            run @actions.resolve_branding_action
                with brandContext = @variables.base_brand_context
                with brandVoiceContext = @variables.base_brand_voice
                set @variables.base_brand_logoKey = @outputs.resolvedLogoKey
                set @variables.base_brand_headerKey = @outputs.resolvedHeaderKey
                set @variables.base_brand_recordKey = @outputs.resolvedBrandRecordKey
                set @variables.base_brand_workspaceId = @outputs.resolvedContentSpaceId
                set @variables.base_brand_include = @outputs.includeBranding
                set @variables.base_brand_suppressLogo = @outputs.suppressLogo
                set @variables.base_brand_suppressHeader = @outputs.suppressHeader
                set @variables.base_brand_note = @outputs.brandingNote
                set @variables.base_brand_resolved = @outputs.brandingResolved

        # Deterministic PLAN -- runs here (not as an LLM tool) so it fires with the captured intent
        # and the resolved brand context, every time, cold. This is the fix for the "multi-lingual
        # email built static" bug: the plan LLM used to be the one discretionary step and could
        # (and did) emit fullTranslate:false / omit the userIntent echo, so translation silently
        # dropped. Now the LLM only CAPTURES the request (note_email_request -> base_content_userIntent);
        # planning is unskippable and bound to that real intent + the brand assets/voice above.
        if @variables.base_content_userIntent != "" and @variables.base_content_structurePlanJson == "" and @variables.base_error_stalled == False:
            run @actions.plan_email_structure_action
                with "Input:UserIntent" = @variables.base_content_userIntent
                with "Input:BrandContext" = @variables.base_brand_context
                with "Input:DataGraphContext" = @variables.base_data_graphContext
                set @variables.base_content_structurePlanJson = @outputs.promptResponse

        # Deterministic drafting pipeline, not LLM-discretionary -- confirmed live,
        # repeatedly, that leaving write_email_copy_tool/assemble_content_plan_tool/
        # validate_content_plan_tool as LLM-callable-only meant the model could show a full,
        # plausible-looking plan summary (with real brand contentKeys it had actually looked
        # up) WITHOUT ever calling any of the three, then get stuck after approval with
        # build_dynamic_email_tool permanently unavailable and no path forward. Three
        # separate rounds of stronger reasoning-instruction wording made zero measurable
        # difference (confirmed via Apex debug logs -- same zero-call signature every time).
        # This runs after EVERY turn regardless of what the LLM decided to do that turn, so
        # the chain advances mechanically instead of depending on the LLM to remember three
        # sequential steps. note_email_request (capturing the request) remains the one LLM-discretionary
        # decision (whether this message is asking to plan a new email) -- everything after
        # that is now unskippable.
        if @variables.base_content_structurePlanJson != "" and @variables.base_content_copyJson == "" and @variables.base_error_stalled == False:
            run @actions.fill_copy_action
                with structurePlanJson = @variables.base_content_structurePlanJson
                with brandVoice = @variables.base_brand_voice
                with userIntent = @variables.base_content_userIntent
                set @variables.base_content_copyJson = @outputs.copyJson
                # Full-translate injects the Country PP into the plan HERE (before copy is filled) --
                # bind the normalized plan back so Assemble Content Plan emits that same PP instead of
                # the un-injected (static) plan. Always non-empty, so this never wipes the plan.
                set @variables.base_content_structurePlanJson = @outputs.normalizedPlanJson
                set @variables.base_error_pipeline = @outputs.errorMessage

        # Fill Email Copy hard failure (e.g. more copy cells than the per-email limit) leaves
        # copyJson empty and returns an error -- stall with that message rather than silently
        # re-running the fill every turn. Same stall pattern as the assemble stage below.
        if @variables.base_content_structurePlanJson != "" and @variables.base_content_copyJson == "" and @variables.base_data_needsGraphChoice == False and @variables.base_error_pipeline != "":
            set @variables.base_error_stalled = True

        if @variables.base_content_copyJson != "" and @variables.base_content_elementsJson == "" and @variables.base_data_needsGraphChoice == False and @variables.base_error_stalled == False:
            run @actions.assemble_content_plan_action_v2
                with structurePlanJson = @variables.base_content_structurePlanJson
                with copyJson = @variables.base_content_copyJson
                with resolvedGraphApiName = @variables.base_data_resolvedGraphApiName
                with availableFieldsJson = @variables.base_data_fieldsJson
                with dataGraphCount = @variables.base_data_graphCount
                with availableGraphNamesJson = @variables.base_data_availableGraphNames
                set @variables.base_content_title = @outputs.title
                set @variables.base_content_subjectLine = @outputs.subjectLine
                set @variables.base_content_preheader = @outputs.preheader
                set @variables.base_content_urlName = @outputs.urlName
                set @variables.base_content_elementsJson = @outputs.elementsJson
                set @variables.base_content_personalizationsJson = @outputs.personalizationsJson
                set @variables.base_content_personalizationNote = @outputs.personalizationNote
                set @variables.base_content_planSummary = @outputs.planSummary
                set @variables.base_data_needsGraphChoice = @outputs.needsGraphChoice
                set @variables.base_data_graphChoiceMessage = @outputs.errorMessage
                set @variables.base_error_pipeline = @outputs.errorMessage

        # Ambiguous data graph -> do NOT stall (that fixed response is for hard errors); the
        # reasoning block asks the user which graph and re-plans. Clear the error so it isn't
        # mistaken for a real pipeline failure.
        if @variables.base_data_needsGraphChoice == True:
            set @variables.base_error_pipeline = ""

        # Separate check, not nested inside the run above -- stops the retry loop the
        # instant assemble fails, rather than re-attempting the identical failing call
        # every single turn with no visibility (the same failure class as build's own
        # silent-retry problem, applied to the drafting stage instead of the build stage).
        # needsGraphChoice is excluded -- that's an ask-the-user case, not a stall.
        if @variables.base_content_copyJson != "" and @variables.base_content_elementsJson == "" and @variables.base_data_needsGraphChoice == False and @variables.base_error_pipeline != "":
            set @variables.base_error_stalled = True

        if @variables.base_content_elementsJson != "" and @variables.base_content_validated == False and @variables.base_data_needsGraphChoice == False and @variables.base_error_stalled == False:
            run @actions.validate_content_plan_action_v2
                with elementsJson = @variables.base_content_elementsJson
                with personalizationsJson = @variables.base_content_personalizationsJson
                with resolvedGraphApiName = @variables.base_data_resolvedGraphApiName
                with availableFieldsJson = @variables.base_data_fieldsJson
                set @variables.base_content_validated = @outputs.isValid
                set @variables.base_error_issuesJson = @outputs.issuesJson

        if @variables.base_content_elementsJson != "" and @variables.base_content_validated == False and @variables.base_error_issuesJson != "" and @variables.base_error_issuesJson != "[]":
            set @variables.base_error_stalled = True

