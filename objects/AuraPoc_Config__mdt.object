<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Per-org configuration for the AuraPoc email builder&apos;s headless JWT auth and default branding assets -- keeps org-specific values out of Apex so this package can be installed into a new org by adding one record instead of editing code.</description>
    <label>AuraPoc Config</label>
    <pluralLabel>AuraPoc Configs</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>CertDevName__c</fullName>
        <description>Developer name of the self-signed Certificate metadata component used to sign the JWT.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Certificate Developer Name</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ConsumerKey__c</fullName>
        <description>Consumer Key of the ExternalClientApplication used for the JWT bearer token exchange.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Consumer Key</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>HeaderContentKey__c</fullName>
        <description>ContentKey of the default header banner image used in generated emails when Include Default Branding is true. Must already exist in this org&apos;s CMS.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Header Content Key</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InstanceUrl__c</fullName>
        <description>My Domain instance URL, e.g. https://your-domain.my.salesforce.com -- used as both the JWT audience and the base URL for all REST/Aura callouts.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Instance URL</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>LogoContentKey__c</fullName>
        <description>ContentKey of the default logo image used in the branding header of generated emails when Include Default Branding is true. Must already exist in this org&apos;s CMS.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Logo Content Key</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RunAsUser__c</fullName>
        <description>Username the JWT is issued for (Auth.JWT.setSub) -- the user the headless Apex actions act as.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Run-As Username</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
